# Cloudflare Pages / Netlify. Los archivos de /assets llevan hash en el nombre: se pueden cachear para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# Datos de referencia y fronteras: cambian solo al regenerarlos con `npm run data`.
/geo/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/data/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/flags/*
  Cache-Control: public, max-age=2592000
/fonts/*
  Cache-Control: public, max-age=31536000
/avatars/*
  Cache-Control: public, max-age=2592000
