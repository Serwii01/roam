# Copia este archivo como .env.local y rellena los valores de tu proyecto de Supabase
# (Project Settings → API). La "anon / publishable key" es pública por diseño: la seguridad
# la ponen las políticas RLS de la base de datos.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Proveedores OAuth activados en Supabase, separados por comas (p. ej. google,github,apple).
# Déjalo vacío hasta configurarlos.
VITE_OAUTH_PROVIDERS=
