# Copia este archivo como .env.local y rellena los valores de tu proyecto de Supabase
# (Project Settings → API). La "anon / publishable key" es pública por diseño: la seguridad
# la ponen las políticas RLS de la base de datos.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Proveedores OAuth activados en Supabase, separados por comas (p. ej. google).
# Déjalo vacío hasta configurarlos.
VITE_OAUTH_PROVIDERS=

# Datos del titular para los textos legales (/privacidad, /aviso-legal, /terminos).
# El NIF y la dirección son obligatorios si la web es una actividad económica (LSSI-CE, art. 10).
VITE_LEGAL_NAME=
VITE_LEGAL_EMAIL=
VITE_LEGAL_NIF=
VITE_LEGAL_ADDRESS=

# Email que se envía a Nominatim para identificar la app (lo pide su política de uso).
VITE_CONTACT_EMAIL=
# Pon "off" si la Fundación OpenStreetMap pide dejar de usar Nominatim: las paradas se guardarán sin región.
VITE_NOMINATIM=

# Solo para un despliegue de demostración sin Supabase (datos en el navegador). Déjalo vacío en producción.
VITE_DEMO=

# Opcional: buscador de lugares Geoapify (entiende español y monumentos). Sin clave se usa Photon.
# Gratis: 3.000 búsquedas/día. Restringe la clave a tu dominio en el panel de Geoapify.
VITE_GEOAPIFY_KEY=

# Avisos en el móvil (Web Push). Claves VAPID: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
# Solo en Vercel (nunca en el navegador): clave privada VAPID, clave secreta de Supabase (service_role / sb_secret_…)
# y un secreto cualquiera para el aviso diario (Vercel lo manda al llamar a /api/push desde el cron).
VAPID_PRIVATE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
